#!/usr/bin/env python3
"""Display Slurm information in a customizable format."""

import argparse
import subprocess
import sys


# Edit the column order and widths here. Leave %E without a width for full reasons.
INFO_FORMAT = "%9u %19H %60N %E"
RECORD_SEPARATOR = "\x1e"


def info():
    try:
        result = subprocess.run(
            ["sinfo", "-R", "-o", INFO_FORMAT + RECORD_SEPARATOR],
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        print("slurm_mgr: sinfo was not found. Run on a host with Slurm installed and sinfo on PATH.", file=sys.stderr)
        return 127

    if result.returncode:
        return result.returncode if result.returncode > 0 else 128 - result.returncode

    for row in result.stdout.split(RECORD_SEPARATOR):
        # sinfo adds a newline after each separator; other newlines belong to the reason.
        row = row.removeprefix("\n")
        if row.strip():
            print(row.replace("\n", ";"))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    info_parser = commands.add_parser("info", help="Show node information")
    info_parser.add_argument(
        "-R", "--list-reasons", action="store_true", required=True,
        help="Show unavailable nodes with the full reason in the last column",
    )
    parser.parse_args(argv)
    return info()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
